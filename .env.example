# GEMINI_API_KEY: Gemini AI API key (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Optional Self-Hosted AI API (Zero Daily Quotas) ---
# AI_PROVIDER: "auto" (use self-hosted when configured, fallback to Gemini),
#              "self_hosted" (strictly use your own server), or "gemini".
AI_PROVIDER="auto"

# SELF_HOSTED_BASE_URL: Base URL of your MisMinutez self-hosted server (see /self-hosted-ai/README.md)
# Automatically resolves /v1/audio/transcriptions and /v1/chat/completions.
SELF_HOSTED_BASE_URL=""

# Or override ASR and LLM endpoints individually (works with Ollama, vLLM, LM Studio, Whisper, LocalAI):
SELF_HOSTED_ASR_URL=""
SELF_HOSTED_LLM_URL=""
SELF_HOSTED_ASR_MODEL="large-v3-turbo"
SELF_HOSTED_LLM_MODEL="qwen2.5:7b"

# Optional shared Bearer token configured on your self-hosted AI server
SELF_HOSTED_API_TOKEN=""
